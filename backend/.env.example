# ---------- Server ----------
NODE_ENV=development
PORT=8080
# Comma-separated list of allowed frontend origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
# Used in email links
FRONTEND_URL=http://localhost:5173

# ---------- Database (Neon PostgreSQL) ----------
# Neon dashboard -> Connection Details -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/verimind?sslmode=require

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# These emails become admins automatically (can run evaluations, manage roles, review escalations)
ADMIN_EMAILS=you@example.com
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# ---------- LLM ----------
# Which LLM the agent uses:
#   mistral   Mistral AI's API — free "Experiment" plan, no card (used for the free Render deployment)
#   local     the GGUF model in the project root (LLM.gguf), runs on this computer
#   anthropic Claude API (paid)
LLM_PROVIDER=local

# --- mistral / any OpenAI-compatible API (Groq, OpenRouter, llama.cpp server) ---
# Key from https://console.mistral.ai -> API Keys
LLM_API_KEY=
LLM_API_BASE_URL=https://api.mistral.ai/v1
LLM_API_MODEL=ministral-8b-latest
# Free tiers allow ~1 request/second; calls are spaced by this many ms
LLM_API_MIN_INTERVAL_MS=1100
# json_schema (default) or json_object if your API doesn't support schemas
LLM_API_JSON_MODE=json_schema

# --- local: GGUF model (path relative to backend/). Default ../LLM.gguf = Mistral 7B Instruct v0.2
LLM_MODEL_PATH=../LLM.gguf
LLM_MODEL_NAME=Mistral 7B Instruct v0.2 (GGUF)
# Optional: download the model on first boot if LLM_MODEL_PATH doesn't exist (cloud hosts)
LLM_MODEL_URL=
# Only if LLM_MODEL_URL points to a private Hugging Face repo (read token)
LLM_MODEL_TOKEN=
# Context window in tokens (RAM grows with this)
LLM_CONTEXT_SIZE=6144
# CPU threads, 0 = auto
LLM_THREADS=0
# false = CPU only. Use auto / cuda / vulkan / metal if you have a GPU with >= 4 GB VRAM
LLM_GPU=false
# Extra self-consistency samples per question (each costs one model call)
LLM_SAMPLES=1

# Only for LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ---------- Confidence thresholds ----------
CONFIDENCE_HIGH=0.8
CONFIDENCE_MEDIUM=0.55

# ---------- Email (Brevo) ----------
# Leave BREVO_API_KEY empty in development: emails (incl. verification codes) are printed to the console.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=VeriMind
